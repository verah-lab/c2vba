<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>de.heuboe.base</groupId>
		<artifactId>jhbpom</artifactId>
		<version>7.1.3</version>
	</parent>

	<groupId>de.heuboe.c2vba</groupId>
	<artifactId>site-config-service-data-c2vba</artifactId>
	<version>1.24.4</version>

	<name>C2VBA ${project.artifactId}</name>
	<description>Data for site config service</description>
	<inceptionYear>2022</inceptionYear>

	<scm>
		<url>https://gitlab.heuboe.hbintern/C2VBA/site-config-service-data-c2vba</url>
		<connection>scm:git:git@gitlab.heuboe.hbintern/C2VBA/site-config-service-data-c2vba</connection>
		<developerConnection>scm:git:git@gitlab.heuboe.hbintern/C2VBA/site-config-service-data-c2vba</developerConnection>
	</scm>

	<build>
		<plugins>

			<!-- Dockering -->
			<plugin>
				<groupId>com.google.cloud.tools</groupId>
				<artifactId>jib-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>docker-build-tar</id>
						<phase>package</phase>
						<goals>
							<goal>buildTar</goal>
						</goals>
					</execution>
					<execution>
						<id>docker-build</id>
						<phase>deploy</phase>
						<goals>
							<goal>build</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<allowInsecureRegistries>true</allowInsecureRegistries>
					<from>
						<image>${docker.registry}/alpine:latest</image>
					</from>
					<to>
						<image>${docker.registry}/heuboe/c2vba/${project.artifactId}:${project.version}</image>
					</to>
					<container>
						<entrypoint>echo "${project.artifactId}:${project.version}"</entrypoint>
						<labels>
							<version>${project.version}</version>
							<build.timestamp>${maven.build.timestamp}</build.timestamp>
							<git.tags>${git.tags}</git.tags>
							<git.commit.id.abbrev>${git.commit.id.abbrev}</git.commit.id.abbrev>
							<git.commit.timestamp>${git.commit.time}</git.commit.timestamp>
						</labels>
						<creationTime>USE_CURRENT_TIMESTAMP</creationTime>
						<filesModificationTime>${git.commit.time}</filesModificationTime>
					</container>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>