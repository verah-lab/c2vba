				<mstm:valueType>trafficFlow</mstm:valueType>
				<mstm:vehType>anyVehicle</mstm:vehType>
				<mstm:basicDataType>TrafficFlow</mstm:basicDataType>
				<mstm:valueElement>vehicleFlow</mstm:valueElement>
				<mstm:value>vehicleFlowRate</mstm:value>
			</mstm:out>
		</mstm:mapping>
		<mstm:mapping>
			<mstm:in>
				<mstm:valColumn>qLKW</mstm:valColumn>
			</mstm:in>
			<mstm:mappingType>period2HourWeighted</mstm:mappingType>
			<mstm:out>
				<mstm:valueType>trafficFlow</mstm:valueType>
				<mstm:vehType>lorry</mstm:vehType>
				<mstm:basicDataType>TrafficFlow</mstm:basicDataType>
				<mstm:valueElement>vehicleFlow</mstm:valueElement>
				<mstm:value>vehicleFlowRate</mstm:value>
			</mstm:out>
		</mstm:mapping>
