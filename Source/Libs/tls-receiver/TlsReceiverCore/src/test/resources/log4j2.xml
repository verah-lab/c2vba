<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">

    <Properties>
        <!-- global layout pattern; designed to show log patterns in fixed sized columns -->
        <!-- see: https://logging.apache.org/log4j/2.x/manual/layouts.html#PatternLayout -->
        <!-- Property name="layoutPattern">%date{ABSOLUTE} | %5.5level | %15.15thread | %25.25logger{1.} | %30.30class{1.}(%line) | %15.15X{context} | %15.15marker |> %message%n</Property -->
        <Property name="layoutPattern">%date{ABSOLUTE} | %5.5level | %15.15thread | %25.25class{1.}(%line) |> %message%n</Property>
    </Properties>

    <Appenders>
    
    
        <Console name="Console" target="SYSTEM_OUT">
        
            <!--PatternLayout pattern="%date{ABSOLUTE} | %5.5level | %15.15thread | %25.25logger{1.} | %30.30class{1.}(%line) | %15.15X{context} | %15.15marker |> %message%n" /-->
            <!--PatternLayout pattern="%date{ABSOLUTE} | %5.5level | %15.15thread | %30.30class{1.}(%line) |> %message%n" /-->
			<PatternLayout>
				<pattern>${layoutPattern}</pattern>
			</PatternLayout>
        </Console>
        
		<RollingFile name="LogFile" 
		             fileName="log/log.log"
		             filePattern="log/log-%d{yyyy-MM-dd HH_mm_ss_SSS}.log">
			<PatternLayout>
				<pattern>${layoutPattern}</pattern>
			</PatternLayout>
			<Policies>
				 <SizeBasedTriggeringPolicy size="10 MB"/>
			</Policies>
			<DefaultRolloverStrategy max="10"/>
		</RollingFile>
		
		
    </Appenders>
	<Loggers>
		<Root level="warn">
			<AppenderRef ref="LogFile" />
			<AppenderRef ref="Console" />
		</Root>
		
		<!-- as an example -->
		<logger name="de.heuboe.nrw.guisvc.brokerfeed.work.Cfg4RcvAndPub" level="debug"
			additivity="false">
			<AppenderRef ref="LogFile" />
			<AppenderRef ref="Console" />
		</logger>

		<Logger name="de.heuboe" level="debug" additivity="false">
			<AppenderRef ref="LogFile" />
			<AppenderRef ref="Console" />
		</Logger>
	</Loggers>
</Configuration>

