				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>de.heuboe.tls</groupId>
				<artifactId>iface-routing-csv</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>de.heuboe.tls</groupId>
				<artifactId>iface-routing-ddp</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- HB Stuff -->
			<dependency>
				<groupId>de.heuboe.base</groupId>
				<artifactId>jddp</artifactId>
				<version>${jddp.version}</version>
			</dependency>
			<dependency>
				<groupId>de.heuboe.base</groupId>
				<artifactId>jhbCsv</artifactId>
				<version>${jhbCsv.version}</version>
			</dependency>
			<dependency>
				<groupId>de.heuboe.base</groupId>
				<artifactId>jhbBase</artifactId>
				<version>${jhbBase.version}</version>
			</dependency>
			<dependency>
				<groupId>de.heuboe.base</groupId>
				<artifactId>jhbDbf</artifactId>
				<version>${jhbDbf.version}</version>
			</dependency>

			<!-- corba -->
			<dependency>
				<groupId>org.jacorb</groupId>
				<artifactId>jacorb</artifactId>
				<version>${jacorb.version}</version>
			</dependency>

			<!-- cxf -->
			<dependency>
				<groupId>org.apache.cxf</groupId>
				<artifactId>cxf-rt-frontend-jaxws</artifactId>
				<version>${cxf.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.cxf</groupId>
				<artifactId>cxf-rt-transports-http</artifactId>
				<version>${cxf.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.cxf</groupId>
				<artifactId>cxf-rt-transports-http-jetty</artifactId>
				<version>${cxf.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.cxf</groupId>
