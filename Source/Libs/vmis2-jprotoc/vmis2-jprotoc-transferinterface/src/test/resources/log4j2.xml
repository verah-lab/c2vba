<?xml version="1.0" encoding="UTF-8"?>
<Configuration strict="true" monitorInterval="15" status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%highlight{%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n}"
                disableAnsi="false" />
        </Console>
    </Appenders>

    <Loggers>
        <Logger name="de.heuboe" level="debug" />

        <Root level="info">
            <AppenderRef ref="Console" />
        </Root>
    </Loggers>
</Configuration>
