<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.heuboe.asfinag</groupId>
        <artifactId>vmis2-base-parent</artifactId>
        <version>2.26.0</version>
    </parent>

    <artifactId>vmis2-tls-resources</artifactId>
    <version>3.3.0</version>
    <packaging>pom</packaging>

    <name>${project.artifactId}</name>
    <description>VMIS2 Parent pom for tls scripts, protos and related generators.</description>
    <url>https://www.heuboe.de</url>
    <inceptionYear>2019</inceptionYear>


    <organization>
        <name>Heusch/Boesefeldt GmbH</name>
        <url>https://www.heuboe.de</url>
    </organization>

    <licenses>
        <license>
            <name>All rights reserved</name>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>ASc</id>
            <name>Alexander Ohlrogge</name>
            <email>alexander.ohlrogge@heuboe.de</email>
        </developer>
    </developers>

    <scm>
        <url>https://gitlab.heuboe.hbintern/VMIS2/tls/vmis2-tls-resources</url>
        <connection>scm:git:git@gitlab.heuboe.hbintern:VMIS2/tls/vmis2-tls-resources.git</connection>
        <developerConnection>scm:git:git@gitlab.heuboe.hbintern:VMIS2/tls/vmis2-tls-resources.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>vmis2-tls-scripts</module>
        <module>vmis2-tls-generator-junit</module>
        <module>vmis2-tls-generator-proto</module>
        <module>vmis2-tls-proto-interface</module>
        <module>vmis2-tls-scripts-tests</module>
    </modules>

    <properties>
        <heuboe.pdb.changelogfile>${basedir}/CHANGELOG.md</heuboe.pdb.changelogfile>

        <!-- plugin versions -->
        <vmis2-protoversion-maven-plugin.version>1.1.0</vmis2-protoversion-maven-plugin.version>

        <!-- dependency versions -->
        <tls-resources.version>3.4.1</tls-resources.version>

        <!-- test dependency versions -->
        <junit-bom.version>5.10.2</junit-bom.version>

        <!-- build plugin versions -->
        <jprotoc.version>4.6.2</jprotoc.version>
        <os-maven-plugin.version>1.6.2</os-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>de.heuboe.tls</groupId>
                <artifactId>tls-generator</artifactId>
                <version>${tls-resources.version}</version>
            </dependency>
            <dependency>
                <groupId>de.heuboe.tls</groupId>
                <artifactId>tls-generator-proto</artifactId>
                <version>${tls-resources.version}</version>
            </dependency>
            <dependency>
                <groupId>de.heuboe.tls</groupId>
                <artifactId>tls-generator-junit</artifactId>
                <version>${tls-resources.version}</version>
            </dependency>
            <dependency>
                <groupId>de.heuboe.tls</groupId>
                <artifactId>tls-resources</artifactId>
                <version>${tls-resources.version}</version>
            </dependency>
            <dependency>
                <groupId>de.heuboe.tls</groupId>
                <artifactId>tls-scripts</artifactId>
                <version>${tls-resources.version}</version>
            </dependency>
            <dependency>
                <groupId>de.heuboe.tls</groupId>
                <artifactId>tls-scripts-tests</artifactId>
                <version>${tls-resources.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
