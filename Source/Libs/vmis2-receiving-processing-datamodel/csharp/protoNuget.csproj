<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.0.0</Version> <!-- azure csharp pipeline will set its own value, no need to change it -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>VMIS2.ReceivingProcessingDatamodel.Proto</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <ContentTargetFolders>proto</ContentTargetFolders>
    <AssemblyName>VMIS2.ReceivingProcessingDatamodel.Proto</AssemblyName>
    <PackageVersion>$(Version)</PackageVersion>
    <Title>VMIS2 Kernsystem Receiving Processing Datamodel</Title>
    <Authors>vmis-ehe</Authors>
    <Description>C# Proto-Files ReceivingProcessing</Description>
    <IncludeSymbols>false</IncludeSymbols>
    <IncludeSource>false</IncludeSource>
    <IsTool>false</IsTool>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\src\main\proto\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>

