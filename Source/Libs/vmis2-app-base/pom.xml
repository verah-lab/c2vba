<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>de.heuboe.asfinag</groupId>
        <artifactId>vmis2-base-parent</artifactId>
        <version>4.1.0</version>
    </parent>
    <name>VMIS2 Kern ${project.artifactId}</name>
    <artifactId>vmis2-app-base</artifactId>
    <version>2.0.0</version>

    <organization>
        <name>Heusch/Boesefeldt GmbH</name>
        <url>http://www.heuboe.de</url>
    </organization>

    <developers>
        <developer>
            <name>Cathleen Schlosshauer</name>
        </developer>
    </developers>

    <scm>
        <url>https://gitlab.heuboe.hbintern/${gitlabProject}</url>
        <connection>scm:git:git@gitlab.heuboe.hbintern:${gitlabProject}.git</connection>
        <developerConnection>scm:git:git@gitlab.heuboe.hbintern:${gitlabProject}.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <gitlabProject>VMIS2/control/base/vmis2-app-base</gitlabProject>
        <vmis2-log4j2-extension.version>1.3.1</vmis2-log4j2-extension.version>
        <sonar.exclusions>src/**/actors/SpringActorProducer.java,src/**/actors/SpringExtension.java</sonar.exclusions>
        <scala.binary.version>2.13</scala.binary.version>
        <akka.version>2.6.21</akka.version>
    </properties>

    <dependencies>
        <!-- HeuBoe -->
        <dependency>
            <groupId>de.heuboe.asfinag</groupId>
            <artifactId>vmis2-configservice-interface</artifactId>
            <version>1.16.22</version>
        </dependency>
        <dependency>
            <groupId>de.heuboe.asfinag</groupId>
            <artifactId>vmis2-constants</artifactId>
            <version>0.0.6</version>
        </dependency>
        <dependency>
            <groupId>de.heuboe.asfinag</groupId>
            <artifactId>vmis2-infrastructure-base</artifactId>
            <version>1.5.1</version>
        </dependency>
        <dependency>
            <groupId>de.heuboe.asfinag</groupId>
            <artifactId>vmis2-control-datamodel</artifactId>
            <version>3.2.1</version>
        </dependency>
        <!-- EHE -->
        <dependency>
            <groupId>eu.vmis-ehe.asfinag</groupId>
            <artifactId>vmis2-paramservice-interface</artifactId>
            <version>1.13.0</version>
        </dependency>
        <dependency>
            <groupId>de.heuboe.idgenerator</groupId>
            <artifactId>heuboe-idgenerator</artifactId>
            <version>2.0.0</version>
        </dependency>

        <!-- protobuf -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java-util</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.google.guava</groupId>
                    <artifactId>guava</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Spring -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- Akka -->
        <dependency>
            <groupId>com.typesafe.akka</groupId>
            <artifactId>akka-actor_${scala.binary.version}</artifactId>
            <version>${akka.version}</version>
        </dependency>
        <!-- https://mvnrepository.com/artifact/com.typesafe.akka/akka-slf4j -->
        <dependency>
            <groupId>com.typesafe.akka</groupId>
            <artifactId>akka-slf4j_${scala.binary.version}</artifactId>
            <version>${akka.version}</version>
        </dependency>


        <!-- https://mvnrepository.com/artifact/org.projectlombok/lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- https://mvnrepository.com/artifact/io.vavr/vavr -->
        <!-- Tuple and other functional stuff -->
        <dependency>
            <groupId>io.vavr</groupId>
            <artifactId>vavr</artifactId>
            <version>0.10.4</version>
        </dependency>
        <dependency>
            <groupId>de.heuboe.asfinag</groupId>
            <artifactId>vmis2-log4j2-extension</artifactId>
            <version>${vmis2-log4j2-extension.version}</version>
        </dependency>

        <!-- testing only -->
        <dependency>
            <groupId>de.heuboe.test</groupId>
            <artifactId>heuboe-kafka-test-utils</artifactId>
            <version>1.2.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>4.2.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.typesafe.akka</groupId>
            <artifactId>akka-testkit_2.13</artifactId>
            <version>${akka.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>
</project>
