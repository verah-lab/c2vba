<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.heuboe.tls</groupId>
        <artifactId>tls-ifacetlsoip-kafka</artifactId>
        <version>1.1.4</version>
    </parent>

    <artifactId>e21x-tls-iface-wancom</artifactId>
    <version>1.1.0</version>

    <description>tls iface wired appplication for WANCOM Kafka and configuration by configService</description>
    <name>${project.artifactId}</name>
    <url>${urlCombined}</url>

    <developers>
        <developer>
            <name>Ronald Nikel</name>
        </developer>
    </developers>

    <scm>
        <url>https://gitlab.heuboe.hbintern/${urlmain}</url>
        <connection>scm:git:git@gitlab.heuboe.hbintern:${urlmain}.git</connection>
        <developerConnection>scm:git:git@gitlab.heuboe.hbintern:${urlmain}.git</developerConnection>
        <tag>v1.1.0</tag>
    </scm>

    <properties>
        <!-- eclipse shows an unknown maven configuration error with maven-jar-plugin 3.1.2 -->
        <!-- https://github.com/spring-projects/spring-boot/issues/16882 -->
<!--        <maven-jar-plugin .version>3.1.1</maven -jar-plugin.version>-->

        <!-- VMIS2 dependency versions -->
        <vmis2-configservice-interface.version>1.16.22</vmis2-configservice-interface.version>
        <vmis2-log4j2-extension.version>1.3.1</vmis2-log4j2-extension.version>
        <vmis2-tls-cfggetter.version>1.4.0</vmis2-tls-cfggetter.version>

        <!-- plugin versions -->
        <jib-maven-plugin.version>3.1.4</jib-maven-plugin.version>

        <sonar.test.exclusions>
            src/test/java/de/heuboe/tls/wancom/kcfg/test/Test1.java,
            src/test/java/de/heuboe/tls/wancom/kcfg/test/Test2.java,
            src/test/java/de/heuboe/tls/wancom/kcfg/test/DoppeltesLottchenTest.java
        </sonar.test.exclusions> <!-- looks like this is necessary for test classes -->

        <!-- Docker -->
        <mainClass>de.heuboe.tls.ifacewancom.IfaceWANCom</mainClass>
        <from.image>${docker.registry}/adoptopenjdk/openjdk11:alpine-jre</from.image>
        <to.image>${docker.registry}/heuboe/tls/${project.artifactId}:${project.version}</to.image>

        <from.image.expanded>${from.image}</from.image.expanded> <!-- in order to hover for instance -->
        <to.image.expanded>${to.image}</to.image.expanded> <!-- in order to hover for instance -->

        <!-- SCM -->
		<urlmain>Tls/${project.artifactId}</urlmain>
        <urlCombined>https://${gitlab}/${urlmain}</urlCombined>
        <gitlab>gitlab.heuboe.hbintern</gitlab>
    </properties>

    <dependencies>
        <!-- HeuBoe -->
        <dependency>
            <groupId>de.heuboe.asfinag</groupId>
            <artifactId>vmis2-log4j2-extension</artifactId>
            <version>${vmis2-log4j2-extension.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency> <!-- support for kafka usage -->
            <groupId>de.heuboe.asfinag</groupId>
            <artifactId>vmis2-kafka-protopojo-converter</artifactId>
        </dependency>

        <!-- tying up loose ends -->
        <dependency>
            <groupId>de.heuboe.tls</groupId>
            <artifactId>iface-lib</artifactId>
        </dependency>
        <dependency>
            <groupId>de.heuboe.tls</groupId>
            <artifactId>tls-ifaceroutingcfg</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>de.heuboe.tls</groupId>
            <artifactId>tls-ifacesysconkafka</artifactId>
            <version>${project.parent.version}</version>
        </dependency>

		<dependency>
			<groupId>de.heuboe.tls</groupId>
			<artifactId>tls-cfgsvc-bridge</artifactId>
            <version>1.0.2</version>
		</dependency>

		<!-- interface of configservice -->
		<dependency>
			<groupId>de.heuboe.asfinag</groupId>
			<artifactId>vmis2-configservice-interface</artifactId>
			<version>${vmis2-configservice-interface.version}</version>
			</dependency>

		<dependency>
			<groupId>de.heuboe.asfinag</groupId>
			<artifactId>vmis2-tls-cfggetter</artifactId>
			<version>${vmis2-tls-cfggetter.version}</version>
		</dependency>

		<!-- third party -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <!--version>${lombok.version}</version -->
        </dependency>

        <!-- https://mvnrepository.com/artifact/com.google.protobuf/protobuf-java-util -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java-util</artifactId>
        </dependency>

        <!-- Spring -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>net.devh</groupId>
            <artifactId>grpc-client-spring-boot-starter</artifactId>
        </dependency>

        <!-- Spring-Metrics -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Kafka -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <dependency>
        	<groupId>org.springframework.boot</groupId>
        	<artifactId>spring-boot-configuration-processor</artifactId>
        	<optional>true</optional>
        </dependency>

        <!-- testing only -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>${jib-maven-plugin.version}</version>

                <executions>
                    <execution>
                        <id>docker-build</id>
                        <phase>deploy</phase>
                        <goals>
                            <goal>build</goal>
                        </goals>
                    </execution>
                </executions>

                <configuration>
                    <from>
                        <image>${from.image}</image>
                    </from>
                    <to>
                        <image>${to.image}</image>
                    </to>
                    <!-- We currently don't use HTTPS -> insecure -->
                    <allowInsecureRegistries>true</allowInsecureRegistries>
                    <container>
                        <jvmFlags>
                            <jvmFlag>-Dlogging.config=/config/log4j2.xml</jvmFlag>
                            <jvmFlag>-Dspring.config.additional-location=/config/</jvmFlag>
                        </jvmFlags>
                        <mainClass>${mainClass}</mainClass>
                        <!-- The ports that the application exposes, including its purpose -->
                        <ports>
                            <port>8080</port><!-- actuator -->
                        </ports>
                        <labels>
                            <version>${project.version}</version>
                            <build.timestamp>${maven.build.timestamp}</build.timestamp>
                            <git.tags>${git.tags}</git.tags>
                            <git.commit.id.abbrev>${git.commit.id.abbrev}</git.commit.id.abbrev>
                            <git.commit.timestamp>${git.commit.time}</git.commit.timestamp>
                        </labels>
                        <creationTime>USE_CURRENT_TIMESTAMP</creationTime>
                        <filesModificationTime>${git.commit.time}</filesModificationTime>
                    </container>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
