	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>com.google.cloud.tools</groupId>
				<artifactId>jib-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>docker-build-tar</id>
						<phase>package</phase>
						<goals>
							<goal>buildTar</goal>
						</goals>
					</execution>
					<execution>
						<id>docker-build</id>
						<phase>deploy</phase>
						<goals>
							<goal>build</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<from>
						<image>${docker.registry}/adoptopenjdk/openjdk11:alpine-jre</image>
<!-- 						<image>${docker.registry}/eclipse-temurin:17-jre-alpine</image> -->
					</from>
					<to>
						<image>${docker.registry}/heuboe/sitesconfig/${project.artifactId}:${project.version}</image>
					</to>
					<container>
						<mainClass>${mainClass}</mainClass>
						<ports>
							<port>8080</port><!-- web -->
						</ports>
						<labels>
							<version>${project.version}</version>
							<build.timestamp>${maven.build.timestamp}</build.timestamp>
							<git.tags>${git.tags}</git.tags>
							<git.commit.id.abbrev>${git.commit.id.abbrev}</git.commit.id.abbrev>
							<git.commit.timestamp>${git.commit.time}</git.commit.timestamp>
						</labels>
						<creationTime>USE_CURRENT_TIMESTAMP</creationTime>
						<filesModificationTime>${git.commit.time}</filesModificationTime>
					</container>

				</configuration>
			</plugin>
		</plugins>
	</build>

	<distributionManagement>
		<repository>
			<id>hb-nexus</id>
			<name>HB Repository</name>
			<url>http://nexus.dmz1.heuboe.hbintern/repository/releases/</url>
		</repository>
		<snapshotRepository>
			<id>hb-nexus</id>
			<name>HB Repository</name>
			<url>http://nexus.dmz1.heuboe.hbintern/repository/snapshots/</url>
		</snapshotRepository>
