<?xml version="1.0" encoding="UTF-8"?>
<Configuration strict="true" monitorInterval="15">

    <Properties>
        <!-- global layout pattern; designed to show log patterns in fixed sized columns -->
        <!-- see: https://logging.apache.org/log4j/2.x/manual/layouts.html#PatternLayout -->
        <!--
            log message will look like this
            2017-05-04 15:02:30,220 | DEBUG | main | d.f.l.Slf4jWithLog4j2Test | d.f.l.Slf4jWithLog4j2Test(  13) |> Hello World! | MDC={}
        -->
<!--         <Property name="layoutPattern">%highlight{%date{DEFAULT} | %5.5level | %15.15thread | %25.25logger{1.} |&gt; %message | %MDC}%n</Property> -->
        <Property name="LOG_EXCEPTION_CONVERSION_WORD">%xwEx</Property>
		<Property name="LOG_LEVEL_PATTERN">%highlight{%5p}</Property>
        <Property name="LOG_DATEFORMAT_PATTERN">yyyy-MM-dd HH:mm:ss.SSS</Property>
		<Property name="CONSOLE_LOG_PATTERN">%clr{%d{${LOG_DATEFORMAT_PATTERN}}}{faint} %clr{${LOG_LEVEL_PATTERN}} %clr{${sys:PID}}{magenta} %clr{---}{faint} %clr{[%15.15t]}{faint} %clr{%-40.40c{1.}}{cyan} %clr{:}{faint} %m%n${sys:LOG_EXCEPTION_CONVERSION_WORD}</Property>
		<Property name="FILE_LOG_PATTERN">%d{${LOG_DATEFORMAT_PATTERN}} ${LOG_LEVEL_PATTERN} ${sys:PID} --- [%t] %-40.40c{1.} : %m%n${sys:LOG_EXCEPTION_CONVERSION_WORD}</Property>
    </Properties>

    <Appenders>
        <Appender type="Console" name="console">
            <Layout type="PatternLayout" pattern="${CONSOLE_LOG_PATTERN}" disableAnsi="false" />
        </Appender>
        <Appender type="RollingRandomAccessFile" name="file" fileName="target/logs/ConfigVersionService.log"
            filePattern="target/logs/ConfigVersionService-%i.log">
            <PatternLayout pattern="${FILE_LOG_PATTERN}" />
            <Policies>
                <Policy type="SizeBasedTriggeringPolicy" size="10MB" />
            </Policies>
            <RolloverStrategy type="DefaultRolloverStrategy" max="10" />
        </Appender>
    </Appenders>

    <Loggers>
        <Logger name="de.heuboe" level="info" />
        <Root level="info">
            <AppenderRef ref="console" />
            <AppenderRef ref="file" />
        </Root>
    </Loggers>

</Configuration>