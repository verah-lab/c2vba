    </xs:complexContent>
  </xs:complexType>
  <xs:simpleType name="DenyReasonEnum">
    <xs:annotation>
      <xs:documentation>Reasons for denial of a request.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
