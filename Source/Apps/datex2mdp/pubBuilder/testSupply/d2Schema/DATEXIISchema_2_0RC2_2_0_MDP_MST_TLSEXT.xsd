  <xs:complexType name="_PrecipitationDetailExtensionType">
    <xs:sequence>
      <xs:element name="PrecipitationDetailExt" type="D2LogicalModel:PrecipitationDetailExt" minOccurs="0" />
      <xs:element name="PrecipitationDetailTLSRawExt" type="D2LogicalModel:PrecipitationDetailTLSRawExt" minOccurs="0" />
      <xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="_PredefinedItineraryVersionedReference">
    <xs:complexContent>
      <xs:extension base="D2LogicalModel:VersionedReference">
