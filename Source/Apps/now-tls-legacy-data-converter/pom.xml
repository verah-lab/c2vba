<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.heuboe.base</groupId>
        <artifactId>heuboe-base-parent</artifactId>
        <version>1.1.0</version>
    </parent>

    <artifactId>now-tls-legacy-data-converter</artifactId>
    <version>2.0.0</version>

    <name>${project.artifactId}</name>
    <description>Converts legacy data in receive and send direction for NI project.</description>
    <url>https://www.heuboe.de</url>
    <inceptionYear>2024</inceptionYear>

    <organization>
        <name>Heusch/Boesefeldt GmbH</name>
        <url>https://www.heuboe.de</url>
    </organization>

    <licenses>
        <license>
            <name>All rights reserved</name>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>AOh</id>
            <name>Alexander Ohlrogge</name>
            <email>alexander.ohlrogge@heuboe.de</email>
        </developer>
    </developers>

    <scm>
        <url>https://gitlab.heuboe.hbintern/ni/entwicklung/tls/now-tls-legacy-data-converter.git</url>
        <connection>scm:git:git@gitlab.heuboe.hbintern:ni/entwicklung/tls/now-tls-legacy-data-converter.git</connection>
        <developerConnection>scm:git:git@gitlab.heuboe.hbintern:ni/entwicklung/tls/now-tls-legacy-data-converter.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <!-- encoding properties -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- sonar properties -->
        <sonar.exclusions>src/**/config/**,src/**/Main.java</sonar.exclusions>
        <sonar.test.exclusions>src/test/**</sonar.test.exclusions>

        <!-- docker -->
        <mainClass>de.now.tls.legacy.data.converter.Main</mainClass>

        <!-- heuboe dependency versions -->
        <tls-cfglib.version>3.0.0</tls-cfglib.version>
        <tls-kafka-operator.version>5.0.1</tls-kafka-operator.version>

        <!-- now dependency versions-->
        <now-tls-proto-interface.version>2.0.0</now-tls-proto-interface.version>

        <!-- vmis2 dependency versions -->
        <vmis2-configservice-interface.version>1.17.1</vmis2-configservice-interface.version>
        <vmis2-kafka-protopojo-converter.version>2.0.0</vmis2-kafka-protopojo-converter.version>
        <vmis2-tls-cfggetter.version>2.0.0</vmis2-tls-cfggetter.version>

        <!-- 3rd party dependency versions -->
        <quartz.version>2.3.2</quartz.version>
        <vavr.version>0.10.4</vavr.version>

        <!-- test dependencies -->
        <heuboe-kafka-test-utils.version>2.0.0</heuboe-kafka-test-utils.version>
    </properties>

    <dependencies>
        <!-- heuboe dependencies -->
        <dependency>
            <groupId>de.heuboe.tls</groupId>
            <artifactId>tls-cfglib</artifactId>
            <version>${tls-cfglib.version}</version>
        </dependency>
        <dependency>
            <groupId>de.heuboe.tls</groupId>
            <artifactId>tls-kafka-operator</artifactId>
            <version>${tls-kafka-operator.version}</version>
        </dependency>

        <!-- now dependencies -->
        <dependency>
            <groupId>de.heuboe.now</groupId>
            <artifactId>now-tls-proto-interface</artifactId>
            <version>${now-tls-proto-interface.version}</version>
        </dependency>

        <!-- vmis2 dependencies -->
        <dependency>
            <groupId>de.heuboe.asfinag</groupId>
            <artifactId>vmis2-configservice-interface</artifactId>
            <version>${vmis2-configservice-interface.version}</version>
        </dependency>
        <dependency>
            <groupId>de.heuboe.asfinag</groupId>
            <artifactId>vmis2-tls-cfggetter</artifactId>
            <version>${vmis2-tls-cfggetter.version}</version>
        </dependency>
        <dependency>
            <groupId>de.heuboe.asfinag</groupId>
            <artifactId>vmis2-kafka-protopojo-converter</artifactId>
            <version>${vmis2-kafka-protopojo-converter.version}</version>
        </dependency>

        <!-- 3rd party dependencies -->
        <dependency>
            <groupId>io.vavr</groupId>
            <artifactId>vavr</artifactId>
            <version>${vavr.version}</version>
        </dependency>
        <dependency>
            <groupId>org.quartz-scheduler</groupId>
            <artifactId>quartz</artifactId>
            <version>${quartz.version}</version>
        </dependency>

        <!-- test dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.heuboe.test</groupId>
            <artifactId>heuboe-kafka-test-utils</artifactId>
            <version>${heuboe-kafka-test-utils.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <!-- exclude local application files from jar -->
                    <exclude>**/application-*.yml</exclude>
                    <!-- exclude template application file from jar -->
                    <exclude>**/application-template.yml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <!-- Dockering -->
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <executions>
                    <!-- Optional -->
                    <!-- Build a tar file to allow local inspection -->
                    <execution>
                        <id>docker-build-tar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>buildTar</goal>
                        </goals>
                    </execution>
                    <!-- Required -->
                    <!-- Upload the image to the registry -->
                    <execution>
                        <id>docker-build</id>
                        <phase>deploy</phase>
                        <goals>
                            <goal>build</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <from>
                        <!-- ${docker.registry} is set via settings.xml -->
                        <image>${docker.registry}/eclipse-temurin:21-jre-alpine</image>
                    </from>
                    <to>
                        <!-- This change is important -->
                        <image>${docker.registry}/heuboe/now/${project.artifactId}:${project.version}</image>
                    </to>
                    <!-- We currently don't use HTTPS -> insecure -->
                    <allowInsecureRegistries>true</allowInsecureRegistries>
                    <container>
                        <jvmFlags>
                            <!-- Flags für Spring -->
                            <jvmFlag>-Dlogging.config=/config/log4j2.xml</jvmFlag>
                            <jvmFlag>-Dspring.config.additional-location=/config/</jvmFlag>
                            <!-- Do not add flags such as -Xmx2G or other parameters here that might be changed later on -->
                        </jvmFlags>
                        <mainClass>${mainClass}</mainClass>
                        <ports>
                            <!-- Ports with their function -->
                            <port>8080</port><!-- web -->
                            <port>9090</port><!-- grpc -->
                        </ports>
                        <labels>
                            <version>${project.version}</version>
                            <build.timestamp>${maven.build.timestamp}</build.timestamp>
                            <!-- Metadata-derived from the git-commit-id-plugin -->
                            <git.tags>${git.tags}</git.tags>
                            <git.commit.id.abbrev>${git.commit.id.abbrev}</git.commit.id.abbrev>
                            <git.commit.timestamp>${git.commit.time}</git.commit.timestamp>
                        </labels>
                        <creationTime>USE_CURRENT_TIMESTAMP</creationTime>
                        <filesModificationTime>${git.commit.time}</filesModificationTime>
                    </container>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
