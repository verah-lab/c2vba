<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>de.heuboe.datex2</groupId>
 	<artifactId>datex2MSTBuilder</artifactId>
	
 	<parent>
		<groupId>de.heuboe.datex2.mst</groupId>
	 	<artifactId>datex2MSTParent</artifactId>
 		<version>5.0.2</version>
		<relativePath>../parent/pom.xml</relativePath>
	</parent>
	
 
 	<properties>
		<additionalparam>-Xdoclint:none</additionalparam>
		
		<datex2.measure.base.version>5.0.0</datex2.measure.base.version>
		<datex2.mst.version>5.0.2</datex2.mst.version>
		<datex2.mst.persistence.version>5.0.0</datex2.mst.persistence.version>
	</properties>

 	<dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        
		<dependency>
			<groupId>de.heuboe.datex2</groupId>
			<artifactId>datex2-mst-persistence</artifactId>
			<version>${datex2.mst.persistence.version}</version>
		</dependency>
		
		<dependency>
			<groupId>de.heuboe.datex2</groupId>
			<artifactId>datex2-schema_2_3</artifactId>
			<version>${datex2.base.version}</version>
		</dependency>

		<dependency>
			<groupId>de.heuboe.datex2</groupId>
			<artifactId>datex2Base</artifactId>
			<version>5.0.1</version>
		</dependency> 

		<dependency>
			<groupId>de.heuboe.datex2</groupId>
			<artifactId>datex2MeasureBase</artifactId>
			<version>${datex2.measure.base.version}</version>
		</dependency> 
		
		<dependency>
			<groupId>de.heuboe.datex2</groupId>
 			<artifactId>datex2MSTConfig</artifactId>
 			<version>${datex2.mst.version}</version>
		</dependency> 
		
		<dependency>
		    <groupId>de.heuboe.datex2</groupId>
    		<artifactId>datex2-push-client</artifactId>
		    <version>5.0.1</version>
		</dependency> 
		
		<dependency>
			<groupId>javax.media</groupId>
			<artifactId>jai_core</artifactId>
		</dependency>
		
		<dependency>
		  	<groupId>org.w3c.tidy</groupId>
		  	<artifactId>jtidy</artifactId>
		  	<version>r938</version>
		</dependency>
		
		
		<!-- cxf -->		
		
		<dependency>
			<groupId>org.apache.cxf</groupId>
			<artifactId>cxf-rt-frontend-jaxws</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.cxf</groupId>
			<artifactId>cxf-tools-common</artifactId>
		</dependency>
		
		<dependency>
			<groupId>org.apache.cxf</groupId>
			<artifactId>cxf-rt-transports-http-jetty</artifactId>
		</dependency>
		
		<dependency>
		    <groupId>xerces</groupId>
		    <artifactId>xercesImpl</artifactId>
			<exclusions>
				<exclusion>
					<groupId>xml-apis</groupId>
					<artifactId>xml-apis</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		
		<!-- for testing only -->

		<dependency>
			<groupId>junit</groupId>
  			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
        
		<dependency>
			<groupId>de.heuboe.base</groupId>
			<artifactId>jhbTest</artifactId>
			<version>2.7.2</version>
			<scope>test</scope>
			
			<exclusions>
				<exclusion>
				    <groupId>com.sun.xml.bind</groupId>
				    <artifactId>jaxb-impl</artifactId>
				</exclusion>
				<exclusion>
				    <groupId>com.sun.xml.bind</groupId>
				    <artifactId>jaxb-api</artifactId>
				</exclusion>
			</exclusions>
			
		</dependency>
		
 	</dependencies>
 	
 	
	<profiles>
	    <profile>
        	<id>repackage</id>
		 	<build>
				<plugins>
					<!-- build an executable jar -->
					<plugin>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-maven-plugin</artifactId>
						<version>2.5.8</version>
						<executions>
							<execution>
								<goals>
									<goal>repackage</goal>
								</goals>
							</execution>
						</executions>
						<configuration>
						    <mainClass>de.heuboe.datex2.mst.builder.client.MSTConfigImporterClient</mainClass>
						</configuration>
					</plugin>
				</plugins>
			</build>
 		</profile>
 	</profiles>
</project>