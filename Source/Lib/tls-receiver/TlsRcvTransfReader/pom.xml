<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>de.heuboe.tls</groupId>
		<artifactId>receive-tls-parent-pom</artifactId>
		<version>2.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>receiver-reader</artifactId>

	<name>${project.artifactId}</name>
	<description>Parser based on antlr4 for receive grammar</description>

	<inceptionYear>2019</inceptionYear>
	<url>${urlCombined}</url>

	<organization>
		<name>Heusch/Boesefeldt GmbH</name>
		<url>https://www.heuboe.de</url>
	</organization>

	<licenses>
		<license>
			<name>All rights reserved - Heusch/Boesefeldt GmbH</name>
		</license>
	</licenses>

	<scm>
		<url>${urlCombined}</url>
		<connection>scm:git:git@${gitlab}:${urlmain}.git</connection>
		<developerConnection>scm:git:git@${gitlab}:${urlmain}.git</developerConnection>
		<tag>HEAD</tag>
	</scm>

	<developers>
		<developer>
			<id>rn</id>
			<name>Ronald Nikel</name>
			<email>ronald.nikel@heuboe.de</email>
		</developer>
	</developers>

	<properties>
	</properties>

	<dependencies>
		<dependency>
			<groupId>de.heuboe.tls</groupId>
			<artifactId>receiver-interfaces</artifactId>
			<version>2.0.1-SNAPSHOT</version>
		</dependency>

		<!-- logging -->
<!-- 		<dependency> -->
<!-- 			<groupId>de.heuboe.base</groupId> -->
<!-- 			<artifactId>jhbBase-logging</artifactId> -->
<!-- 			<version>3.1.0</version> -->
    <!-- 		</dependency> -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
        </dependency>

		<dependency>
			<groupId>org.antlr</groupId>
			<artifactId>antlr4-runtime</artifactId>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>de.heuboe.base</groupId>
			<artifactId>jhbRegressionTest</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.antlr</groupId>
				<artifactId>antlr4-maven-plugin</artifactId>
                <version>${antlr4.version}</version>
				<executions>
					<execution>
						<phase>generate-sources</phase>
						<goals>
							<goal>antlr4</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>add-source</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>${project.build.directory}/generated-sources/antlr4</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>