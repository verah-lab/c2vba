<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
	<Appenders>
		<Console name="Console" target="SYSTEM_OUT">
			<PatternLayout
				pattern="%highlight{%d{HH:mm:ss.SSS} [%t#%tid] %-5level %logger{36}(%line) - %msg%n}" disableAnsi="false" />
		</Console>
	</Appenders>
	<Loggers>
		<Root level="warn">
			<AppenderRef ref="Console" />
		</Root>
<!--         <Logger name="org.apache.kafka" level="debug" /> -->
<!--         <Logger name="de.heuboe.asfinag.tls.tele.in.TlsKafkaTelgramReceiver" level="trace" /> -->

		<Logger name="de.heuboe" level="info" /> 
		<Logger name="org.springframework" level="warn" />
        <logger name="de.heuboe.asfinag.tls.receiver.datawriter" level="debug"
            additivity="false">
<!--             <AppenderRef ref="LogFile" /> -->
            <AppenderRef ref="Console" />
        </logger>
        <Logger name="org.apache.kafka.clients.consumer.ConsumerConfig" level="warn" />
        <Logger name="org.apache.kafka.clients.producer.ProducerConfig" level="warn" />
        <Logger name="org.apache.kafka.clients.admin.AdminClientConfig" level="warn" />
        
		<Logger name="eu.vmis_ehe.vmis2.tls.received.conv.Fg1ConvTlsRcvCvt" level="debug" />
		<Logger name="eu.vmis_ehe.vmis2.tls.received.conv.Fg2ConvTlsRcvCvt" level="debug" />
		<Logger name="eu.vmis_ehe.vmis2.tls.received.conv.Fg3ConvTlsRcvCvt" level="debug" />
		<Logger name="eu.vmis_ehe.vmis2.tls.received.conv.Fg4ConvTlsRcvCvt" level="debug" />
		<Logger name="eu.vmis_ehe.vmis2.tls.received.conv.Fg6ConvTlsRcvCvt" level="debug" />
		<Logger name="eu.vmis_ehe.vmis2.tls.received.conv.Fg9ConvTlsRcvCvt" level="debug" />
		<Logger name="eu.vmis_ehe.vmis2.tls.received.conv.Fg254ConvTlsRcvCvt" level="debug" />
	</Loggers>
</Configuration>