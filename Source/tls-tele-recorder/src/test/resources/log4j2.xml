<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <Properties>
        <Property name="LOG_PATTERN">
            %date{HH:mm:ss,SSS} | %highlight{%5.5level | %25.25logger{1}} | %m%n
        </Property>
    </Properties>

    <Appenders>
        <Console name="STDOUT" target="SYSTEM_OUT" follow="true">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>
    </Appenders>

    <Loggers>
        <Logger name="org.apache.kafka" level="ERROR" />
        <Logger name="org.apache.kafka.common.metrics" level="ERROR" />
        <Logger name="org.springframework.data.convert.CustomConversions" level="ERROR" />
        <Logger name="de.heuboe.tls.tele.recorder" level="INFO" />
        <Logger name="de.heuboe.tls.parser.proto" level="WARN" />
        <Logger name="de.heuboe.tls.kafka.operator" level="INFO" />

        <Root level="ERROR">
            <AppenderRef ref="STDOUT" />
        </Root>
    </Loggers>

</Configuration>
